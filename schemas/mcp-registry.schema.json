{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shiploom.dev/schemas/mcp-registry",
  "title": "Shiploom MCP registry (cap.* abstraction)",
  "description": "Validates .shiploom/mcp-registry.json (MASTER_SPEC 11.12, 20). Core references cap.* only; server names live here. Swap provider = edit registry, not skills.",
  "type": "object",
  "required": ["capabilities"],
  "properties": {
    "capabilities": {
      "type": "object",
      "patternProperties": {
        "^cap\\.[a-z0-9._-]+$": {
          "type": "object",
          "required": ["providers", "ttlS"],
          "properties": {
            "providers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "trust": { "type": "string", "enum": ["first-party", "attested", "community", "quarantined", "untrusted"] },
            "ttlS": { "type": "integer", "minimum": 0 },
            "fallback": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "servers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["transport", "version", "attested", "scopes", "auth"],
        "properties": {
          "transport": { "type": "string", "enum": ["stdio", "sse", "streamable-http", "http"] },
          "version": { "type": "string", "minLength": 1 },
          "attested": { "type": "boolean" },
          "scopes": { "type": "array", "items": { "type": "string" } },
          "auth": {
            "type": "string",
            "description": "Env/keychain ref only, never a secret. e.g. env:TAVILY_KEY",
            "pattern": "^(env:[A-Z0-9_]+|(keychain|secret):.+)$"
          },
          "attestation": {
            "type": "object",
            "description": "Optional evidence behind attested:true (PR16). Absent details + attested:true means unverified claim.",
            "required": ["method"],
            "properties": {
              "method": { "type": "string",
                          "enum": ["sigstore", "pinned-digest", "tofu"] },
              "digest": { "type": "string", "minLength": 1 },
              "signedBy": { "type": "string", "minLength": 1 },
              "verifiedAt": { "type": "string",
                              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
